  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6dcf75fcb66292c4091b5dc344601655, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcTalk
  speaker: VAULT KEEPER
  promptText: TALK
  lines:
  - You came through the forge alive. The king's men stopped coming that way a long
    time ago.
  - The king kept the Crimson stock under his own hall. He said no one else could
    be trusted with it.
  - He was right, in a way. It never left. It went into him instead.
  - He is very large now. Stand under him and he will crush you. Stand far and the
    floor itself will reach you.
  - If you mean to go up, jump the shockwaves. Don't try to outrun them.
  repeatLines:
  - Jump the shockwaves.
  - He still thinks the hold is his.
  radius: 2.6
  facePlayer: 1
  model: {fileID: 317380603}
