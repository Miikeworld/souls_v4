  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6dcf75fcb66292c4091b5dc344601655, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcTalk
  speaker: LINE WORKER
  promptText: TALK
  lines:
  - Line nine. Shift... shift... what shift is it?
  - Violet to the left racks. Red to the right, and never touch the red bare-handed.
    I tell them every shift.
  - We pushed the cores past their rating. More heat, more output. The orders came
    from above, so we pushed.
  - When the Crucible broke, the sentinel sealed the hall. Its last order was simple.
    Nothing leaves.
  - You... your Core is humming. Same note the old containment made. How are you
    carrying that?
  repeatLines:
  - Violet left. Red right. Never bare-handed.
  - Line nine. Shift... shift...
  radius: 2.6
  facePlayer: 1
  model: {fileID: 1533830941}
